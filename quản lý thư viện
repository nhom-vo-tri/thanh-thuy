<!DOCTYPE html>
<html lang="vi">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>QUẢN LÝ THƯ VIỆN</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#ecf0f1;
}

header{
height:300px;
background:url("https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=1600");
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
color:white;
}

header h1{
font-size:50px;
background:rgba(0,0,0,.5);
padding:15px;
border-radius:10px;
}

header p{
margin-top:10px;
font-size:20px;
background:rgba(0,0,0,.5);
padding:10px;
border-radius:10px;
}

nav{
background:#2c3e50;
display:flex;
justify-content:center;
flex-wrap:wrap;
}

nav button{
padding:18px;
border:none;
background:none;
color:white;
font-size:17px;
cursor:pointer;
transition:.3s;
}

nav button:hover{
background:#3498db;
}

.page{
display:none;
padding:20px;
}

.active{
display:block;
}
.cardbox{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-top:20px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
text-align:center;
box-shadow:0 3px 8px rgba(0,0,0,.2);
}

.card h2{
color:#3498db;
margin-top:10px;
}

table{
width:100%;
margin-top:20px;
background:white;
border-collapse:collapse;
}

th{
background:#3498db;
color:white;
padding:12px;
}

td{
padding:10px;
text-align:center;
border-bottom:1px solid #ddd;
}

.actionBtn{
padding:8px 12px;
border:none;
border-radius:5px;
cursor:pointer;
color:white;
}

.addBtn{
background:#2ecc71;
}

.deleteBtn{
background:#e74c3c;
}

.searchBox{
padding:10px;
width:300px;
margin-top:10px;
margin-left:10px;
}

.categoryRow{
font-weight:bold;
color:white;
}

.vanhoc{ background:#f39c12; }
.truyentranh{ background:#27ae60; }
.lichsu{ background:#8e44ad; }
.tieuthuyet{ background:#2980b9; }
.trinhtham{ background:#c0392b; }
.dammy{ background:#e91e63; }

/* thêm thể loại mới */
.kinhdi{ background:#2c3e50; }
.ngontinh{ background:#ff6b81; }
.kynang{ background:#16a085; }
.trietly{ background:#7f8c8d; }
.truyenky{ background:#d35400; }
.cachmang{ background:#34495e; }
.tuybut{ background:#9b59b6; }
.coaphong{ background:#e67e22; }

footer{
background:#2c3e50;
color:white;
padding:20px;
text-align:center;
margin-top:20px;
}

@media(max-width:900px){
.cardbox{ grid-template-columns:repeat(2,1fr); }
}

@media(max-width:600px){
.cardbox{ grid-template-columns:1fr; }
}
</style>

</head>
